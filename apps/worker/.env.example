# ==============================================================================
# FilmyFrolic Background Worker (.env.example)
# Application: apps/worker
# ==============================================================================
# Security Notice:
# Copy this file to '.env' in your local environment.
# DO NOT commit '.env', '.env.local', or real secrets to source control.
# Server-only secrets MUST NEVER use VITE_ prefixes!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Database Secrets
# ------------------------------------------------------------------------------
# [SCOPE: SERVER_ONLY | RUNTIME] Environment mode ('development' | 'production')
NODE_ENV=development

# [SCOPE: SERVER_ONLY | RUNTIME] Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# [SCOPE: SERVER_ONLY | RUNTIME] Supabase service role key (SECRET: Bypasses RLS for queue jobs)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Ingestion & Messaging Integrations
# ------------------------------------------------------------------------------
# [SCOPE: SERVER_ONLY | RUNTIME] TMDB API v3 key for ingestion tasks
TMDB_API_KEY=your_tmdb_api_key

# [SCOPE: SERVER_ONLY | RUNTIME] Resend API Key for notification dispatches (SECRET)
RESEND_API_KEY=your_resend_api_key
