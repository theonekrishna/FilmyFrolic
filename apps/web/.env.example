# ==============================================================================
# FilmyFrolic Web Client (.env.example)
# Application: apps/web
# ==============================================================================
# Security Notice:
# Copy this file to '.env' in your local environment.
# DO NOT commit '.env', '.env.local', or real secrets to source control.
# Variables prefixed with VITE_ are exposed to the client browser bundle!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Connection Settings
# ------------------------------------------------------------------------------
# [SCOPE: PUBLIC | RUNTIME/BUILD_TIME] Primary Express 5 API server URL
VITE_API_URL=http://localhost:5000
VITE_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Supabase Client Credentials
# ------------------------------------------------------------------------------
# [SCOPE: PUBLIC | RUNTIME/BUILD_TIME] Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# [SCOPE: PUBLIC | RUNTIME/BUILD_TIME] Supabase public anonymous API key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# 3. Third-Party Web Integrations
# ------------------------------------------------------------------------------
# [SCOPE: PUBLIC | RUNTIME/BUILD_TIME] Google OAuth Client ID for SSO
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# [SCOPE: PUBLIC | RUNTIME/BUILD_TIME] Agora RTC WebRTC App ID for Live Rooms
VITE_AGORA_APP_ID=your_agora_app_id
