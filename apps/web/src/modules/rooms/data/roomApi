import axios from "axios";

const BASE_URL = (import.meta.env.VITE_BASE_URL || "https://filmyfrolic-api.onrender.com").replace(/\/+$/, "");

const API = axios.create({
  baseURL: BASE_URL,
  withCredentials: true,
});

// GET ROOMS
export const getRoomsAPI = () => API.get(`/api/rooms`);

// CREATE ROOM
export const createRoomAPI = (data) => {
  return API.post("/api/rooms", data, {
    headers: { "Content-Type": "multipart/form-data" },
  });
};

// JOIN ROOM
export const joinRoomAPI = (data) => API.post("/api/rooms/join", data);

// EXIT ROOM
export const exitRoomAPI = (data) => API.post("/api/rooms/exit", data);

export default API;
