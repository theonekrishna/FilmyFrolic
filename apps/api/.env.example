# ==============================================================================
# FilmyFrolic Express API Server (.env.example)
# Application: apps/api
# ==============================================================================
# Security Notice:
# Copy this file to '.env' in your local environment.
# DO NOT commit '.env', '.env.local', or real secrets to source control.
# Server-only secrets MUST NEVER use VITE_ prefixes!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration & CORS
# ------------------------------------------------------------------------------
# [SCOPE: SERVER_ONLY | RUNTIME] Port number Express listens on
PORT=5000

# [SCOPE: SERVER_ONLY | RUNTIME] Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# [SCOPE: SERVER_ONLY | RUNTIME] Comma-separated list of permitted CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Supabase Server Connection & Secrets
# ------------------------------------------------------------------------------
# [SCOPE: SERVER_ONLY | RUNTIME] Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# [SCOPE: SERVER_ONLY | RUNTIME] Supabase public anonymous key
SUPABASE_ANON_KEY=your_supabase_anon_key

# [SCOPE: SERVER_ONLY | RUNTIME] Supabase service role key (SECRET: Bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. Third-Party Integration Credentials
# ------------------------------------------------------------------------------
# [SCOPE: SERVER_ONLY | RUNTIME] TMDB API v3 Key for movie metadata proxying
TMDB_API_KEY=your_tmdb_api_key

# [SCOPE: SERVER_ONLY | RUNTIME] Agora App ID for RTC token generation
AGORA_APP_ID=your_agora_app_id

# [SCOPE: SERVER_ONLY | RUNTIME] Agora App Certificate (SECRET)
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# [SCOPE: SERVER_ONLY | RUNTIME] Resend API Key for transactional emails (SECRET)
RESEND_API_KEY=your_resend_api_key
